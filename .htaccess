# ============================================================
#  Colegio Parroquial Juan XXIII
# ============================================================

Options -Indexes
DirectoryIndex index.php
# Las carpetas vacías que chocaban con una página del mismo nombre
# (Contacto/, Inscripciones/, Institucional/…) se eliminaron al ordenar
# el proyecto. Se deja DirectorySlash apagado igual: la regla de más
# abajo agrega la barra final solo a las carpetas reales, y así una
# futura carpeta homónima no vuelve a tapar su .php.
DirectorySlash Off

# ── Redirecciones 301: las páginas pasaron de .html a .php ──
# Mantiene vivos los links viejos (buscadores, favoritos, WhatsApp).
# Importante: se arma la URL de redirección a partir de REQUEST_URI
# (la ruta dentro del sitio), no de REQUEST_FILENAME. En Windows,
# REQUEST_FILENAME es la ruta absoluta en disco (C:/xampp/htdocs/...),
# y usarla filtraba esa ruta dentro del Location de la redirección,
# rompiendo el link con un 403/404 en vez de llevar a la página nueva.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Aplica las reglas también a carpetas pedidas sin barra final ("/JUAN23CLAUDE", "/contacto")
  RewriteOptions AllowNoSlash

  # ── HTTP → HTTPS (se activa sola el día de la publicación) ──
  # El certificado y el filtrado de tráfico los da Cloudflare sobre el
  # dominio definitivo; esto es la parte que depende del código: que
  # nadie termine navegando el sitio en claro.
  # Va PRIMERO para que una URL vieja (.html, .php) haga un solo salto
  # a su versión https, y no uno a http y otro a https.
  #  - %{HTTPS} cubre el certificado instalado en el propio servidor.
  #  - X-Forwarded-Proto cubre el modo "proxy" de Cloudflare: ahí el
  #    visitante ya viene por https y solo el tramo interno es http;
  #    sin esta condición la redirección se repetiría en bucle.
  #  - localhost / 127.0.0.1 quedan afuera: en el XAMPP de desarrollo
  #    no hay certificado y la regla dejaría el sitio inaccesible.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-Proto} !=HTTPS
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # La antigua "recorrido-virtual.html" nunca existió: iba al 360°
  RewriteCond %{REQUEST_URI} ^(.*)/recorrido-virtual\.html$
  RewriteRule ^ %1/recorrido-360 [R=301,L]

  # index.html / index.php → la carpeta ("/" en vez de "/index")
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s([^?\s]*/)index\.(php|html)[?\s]
  RewriteRule ^ %1 [R=301,L,NE]

  # Cualquier .html que tenga su equivalente .php redirige a la URL limpia.
  # Se aplica AUNQUE el .html siga existiendo en la carpeta, para que
  # nadie vea la versión vieja de la página.
  RewriteCond %{REQUEST_URI} ^(.*)\.html$
  RewriteCond %{DOCUMENT_ROOT}%1.php -f
  RewriteRule ^ %1 [R=301,L,NE]

  # ── URLs sin extensión ──
  # 1) Links viejos con ".php" (favoritos, buscadores) → misma URL sin
  #    ".php". Solo GET: un POST redirigido perdería los datos enviados.
  #    Se mira THE_REQUEST (lo que pidió el navegador) para no entrar en
  #    bucle con la reescritura interna del paso 2.
  #    sync_instagram.php queda afuera: lo llaman tareas programadas con
  #    curl, que no sigue redirecciones.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{REQUEST_URI} !/sync_instagram\.php$
  RewriteCond %{THE_REQUEST} \s([^?\s]+)\.php[?\s]
  RewriteRule ^ %1 [R=301,L,NE]

  # Carpeta real sin página del mismo nombre → con barra final
  # (reemplaza a DirectorySlash, que está apagado más arriba)
  RewriteCond %{REQUEST_URI} ^(.*[^/])$
  RewriteCond %{DOCUMENT_ROOT}%1 -d
  RewriteCond %{DOCUMENT_ROOT}%1.php !-f
  RewriteRule ^ %1/ [R=301,L,NE]

  # 2) "/historia" se sirve con historia.php (la barra sigue diciendo "/historia")
  RewriteCond %{REQUEST_URI} ^(.*[^/])$
  RewriteCond %{DOCUMENT_ROOT}%1.php -f
  RewriteRule ^ %1.php [L]
</IfModule>

# ── Archivos que NO deben servirse nunca ────────────────────
<FilesMatch "\.(sql|md|log|ini|bak|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(conexion|config\.local|panel_config|panel_header)\.php$">
  # Son includes: no tiene sentido abrirlos directo, pero PHP los
  # ejecuta y no filtran nada. Se bloquean por prolijidad.
  Require all denied
</FilesMatch>
<Files "posts_simulados.json">
  Require all denied
</Files>
# Archivos marcados "-sinuso": versiones viejas y utilidades locales que
# quedaron en el repo como referencia (los .html previos al pasaje a PHP,
# config-sinuso.php, generar_hash-sinuso.php). No forman parte del sitio y
# no deben servirse: si no, "/historia-sinuso.html" mostraría la página vieja.
<FilesMatch "-sinuso\.">
  Require all denied
</FilesMatch>

# ── Páginas de error propias ────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# ── Compresión ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Caché de estáticos ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
</IfModule>

# ── Cabeceras de seguridad ──────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  # HSTS: le dice al navegador que, durante un año, entre siempre por
  # https sin pasar por la redirección de arriba. Solo se manda cuando
  # la visita YA llegó por https (env=HTTPS), así en el XAMPP local
  # —donde no hay certificado— la cabecera no sale y no deja el
  # navegador "clavado" en https contra localhost.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
